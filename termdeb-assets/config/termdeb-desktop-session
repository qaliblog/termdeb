#!/bin/bash
# termdeb-desktop-session - Guest side of the TermDeb Lomiri desktop
#
# Runs INSIDE the packaged Debian trixie userspace (under proot) and brings up
# the display stack plus the bridge that feeds the Android app:
#
#   1. an OUTER Mir server (mir_demo_server) on an offscreen *virtual* output,
#      rendered in software (mir:egl-generic) so it needs no GPU/DRM access.
#      It owns the output the app displays and the Wayland seat the app's input
#      is injected into;
#   2. the LOMIRI shell, whose own Mir server (qtmir's "mirserver" QPA) nests on
#      the outer server through Mir's nested-Wayland display platform
#      (mir:wayland). This is required: Mir's virtual platform reports no display
#      sync groups at all, so qtmir can never bind a render target to it and the
#      shell dies in Screen::makeCurrent();
#   3. termdeb-mir-bridge on the OUTER server, which captures its output with the
#      Wayland wlr-screencopy protocol into a shared framebuffer that the Android
#      app maps, and injects input from the app through the Wayland virtual
#      keyboard/pointer protocols.
#
# The framebuffer and input socket live in /run/termdeb, which the host script
# bind-mounts from the app's data directory. This is a local shared-memory
# display path, NOT VNC or a remote desktop.
#
# Copyright (c) TermDeb Contributors
# SPDX-License-Identifier: MIT

set -u

log() { echo "TermDeb desktop[guest]: $*"; }

FB_PATH="${TERMDEB_DESKTOP_FB:-/run/termdeb/fb.buf}"
INPUT_SOCKET="${TERMDEB_DESKTOP_INPUT_SOCKET:-termdeb-desktop-input}"

# Weak symbol entry point for the input platform Mir needs (see below).
MIR_INPUT_LIB="termdeb:input-stub"

# Keeps Mir's nested-Wayland platform from aborting when a signal interrupts its
# event loop; built by provision-desktop.sh, see prebuilt/mir-eintr-shim/.
MIR_EINTR_SHIM="/usr/local/lib/termdeb-mir-eintr-shim.so"

# ---- Runtime directory ------------------------------------------------------
# Android only permits writable app-private storage; /run may not exist in the
# rootfs (systemd is not PID 1 under proot), so create the runtime dirs eagerly.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/termdeb/runtime}"
mkdir -p "${XDG_RUNTIME_DIR}" "${XDG_RUNTIME_DIR}/pulse"
chmod 700 "${XDG_RUNTIME_DIR}" 2>/dev/null || true

# ---- Session D-Bus ----------------------------------------------------------
# The Lomiri shell and its session helpers talk to a session bus; without one the
# shell's session setup floods its log with
#   dbus-update-activation-environment: error: unable to connect to D-Bus
# and never finishes starting. The Android guest has no login session, so start a
# bus of our own unless the app already provided one.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-daemon >/dev/null 2>&1; then
  _bus_addr="$(dbus-daemon --session --fork --print-address=1 \
    --address="unix:path=${XDG_RUNTIME_DIR}/bus" 2>/dev/null || true)"
  if [ -n "${_bus_addr}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="${_bus_addr}"
    log "Session bus started at ${XDG_RUNTIME_DIR}/bus"
  else
    log "WARNING: could not start a session D-Bus; the shell may fail to start"
  fi
fi

# ---- System D-Bus -----------------------------------------------------------
# The session bus is not enough: logind, AccountsService, polkit and the
# app-launch machinery live on the *system* bus, and the shell asks for them. With
# no system bus its lookups fail and the desktop stays inert - the shell logs
# "Not connected to D-Bus server" for AccountsService and "Invalid session path"
# for logind, cannot resolve the app ids the launcher asks about, and never gets a
# user session. A guest has no bus running, so start one (time-boxed: a broken or
# slow bus must not hold up the desktop).
if [ ! -S /run/dbus/system_bus_socket ] && command -v dbus-daemon >/dev/null 2>&1; then
  mkdir -p /run/dbus 2>/dev/null || true
  if timeout 15 dbus-daemon --system --fork --nopidfile >/dev/null 2>&1 &&
     [ -S /run/dbus/system_bus_socket ]; then
    log "System bus started at /run/dbus/system_bus_socket"
  else
    log "WARNING: could not start a system D-Bus; logind/AccountsService stay unreachable"
  fi
fi

# ---- Desktop geometry -------------------------------------------------------
# The Android app preallocates the shared framebuffer and publishes the desktop
# size in its header (width at byte 8, height at byte 12, little-endian).
read_u32() {
  od -An -tu4 -j "$1" -N4 "$2" 2>/dev/null | tr -d ' \n'
}
WIDTH=1280
HEIGHT=800
if [ -f "${FB_PATH}" ]; then
  _w=$(read_u32 8 "${FB_PATH}")
  _h=$(read_u32 12 "${FB_PATH}")
  [ -n "${_w}" ] && [ "${_w}" -gt 0 ] 2>/dev/null && WIDTH="${_w}"
  [ -n "${_h}" ] && [ "${_h}" -gt 0 ] 2>/dev/null && HEIGHT="${_h}"
fi
log "Desktop geometry: ${WIDTH}x${HEIGHT}"

# ---- Clean up any previous session -----------------------------------------
pkill -f termdeb-mir-bridge 2>/dev/null || true
pkill -f lomiri 2>/dev/null || true
pkill -f mir_demo_server 2>/dev/null || true
pkill -f lomiri-system-compositor 2>/dev/null || true
sleep 1

cleanup() {
  log "Shutting down desktop..."
  [ -n "${APP_PID:-}" ] && kill "${APP_PID}" 2>/dev/null || true
  for _pid in ${INDICATOR_PIDS:-}; do kill "${_pid}" 2>/dev/null || true; done
  [ -n "${BRIDGE_PID:-}" ] && kill "${BRIDGE_PID}" 2>/dev/null || true
  [ -n "${LOMIRI_PID:-}" ] && kill "${LOMIRI_PID}" 2>/dev/null || true
  [ -n "${MIR_PID:-}" ] && kill "${MIR_PID}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# List the Wayland sockets Mir has created so far, oldest name first.
wayland_sockets() {
  for _sock in "${XDG_RUNTIME_DIR}"/wayland-*; do
    [ -S "${_sock}" ] && printf '%s\n' "${_sock}"
  done
}

# Wait until a Wayland socket appears that is not in the "known" list.
wait_for_new_socket() {
  local known="$1" limit="$2" _sock
  for _ in $(seq 1 "${limit}"); do
    for _sock in $(wayland_sockets); do
      case " ${known} " in
        *" ${_sock} "*) ;;
        *) printf '%s' "${_sock}"; return 0 ;;
      esac
    done
    sleep 0.5
  done
  return 1
}

# ---- 1. Outer Mir server (virtual output, software rendering) ---------------
#
# Mir's "virtual" display platform provides an offscreen output sized by its own
# --virtual-output option; the "egl-generic" rendering platform keeps everything
# on llvmpipe so no DRM/GPU device is required inside proot. Both platform
# modules have to be installed in the rootfs (mir-platform-graphics-virtual and
# mir-platform-rendering-egl-generic): without them Mir aborts with
# "Failed to load platform", and without --platform-input-lib it aborts with
# "No appropriate input platform module found".
#
# Do NOT pass --wayland-extensions here: the built-in default set already
# contains everything we need (xdg_wm_base, wl_shell, zwlr_screencopy_manager_v1,
# zwlr_virtual_pointer_manager_v1, zwp_virtual_keyboard_manager_v1,
# zxdg_output_manager_v1, ...) and Mir refuses to start for a single unknown
# name in that list.
MIR_BIN=""
for candidate in mir_demo_server miral-shell; do
  if command -v "${candidate}" >/dev/null 2>&1; then MIR_BIN="${candidate}"; break; fi
done

if [ -z "${MIR_BIN}" ]; then
  log "ERROR: no Mir server binary found (expected mir_demo_server or miral-shell)."
  log "The Debian rootfs was not provisioned with the Lomiri desktop packages."
  exit 1
fi
log "Starting Mir compositor: ${MIR_BIN}"

"${MIR_BIN}" \
  --platform-display-libs mir:virtual \
  --platform-rendering-libs mir:egl-generic \
  --platform-input-lib "${MIR_INPUT_LIB}" \
  --virtual-output "${WIDTH}x${HEIGHT}" \
  --console-provider none \
  >"${XDG_RUNTIME_DIR}/mir.log" 2>&1 &
MIR_PID=$!

# Mir names its socket itself (wayland-0 unless something else holds it), so
# discover it instead of assuming a name. --host-socket from Mir 1.x does not
# exist in Mir 2.20 and would make the server reject the whole invocation.
OUTER_SOCKET=""
for _ in $(seq 1 40); do
  OUTER_SOCKET="$(wayland_sockets | head -1)"
  [ -n "${OUTER_SOCKET}" ] && break
  if ! kill -0 "${MIR_PID}" 2>/dev/null; then
    log "ERROR: the Mir compositor (${MIR_BIN}) exited during startup."
    log "--- ${XDG_RUNTIME_DIR}/mir.log ---"
    tail -n 20 "${XDG_RUNTIME_DIR}/mir.log" 2>/dev/null || true
    exit 1
  fi
  sleep 0.5
done
if [ -z "${OUTER_SOCKET}" ]; then
  log "ERROR: Mir did not create a Wayland socket in ${XDG_RUNTIME_DIR}."
  log "--- ${XDG_RUNTIME_DIR}/mir.log ---"
  tail -n 20 "${XDG_RUNTIME_DIR}/mir.log" 2>/dev/null || true
  exit 1
fi
OUTER_DISPLAY="$(basename "${OUTER_SOCKET}")"
log "Mir is up (${OUTER_SOCKET})."

# ---- 2. Lomiri shell --------------------------------------------------------
#
# `lomiri` always selects qtmir's "mirserver" QPA, i.e. the shell *is* a Mir
# server: it ignores QT_QPA_PLATFORM=wayland and MIR_SERVER_HOST_SOCKET (both
# Mir 1.x-era mechanisms). It is configured through Mir's MIR_SERVER_* variables
# and nests on the outer server with the mir:wayland display platform, which is
# what gives qtmir the display sink it needs. Without the nesting Lomiri probes
# only device display platforms and dies with
#   Failed to find any platforms for current system
# or, when it does get a virtual platform, crashes in
#   PlatformScreen::makeCurrent() / Screen::makeCurrent()
# because that platform exposes no sync groups.
LOMIRI_BIN=""
for candidate in lomiri lomiri-system-compositor; do
  if command -v "${candidate}" >/dev/null 2>&1; then LOMIRI_BIN="${candidate}"; break; fi
done

if [ -n "${LOMIRI_BIN}" ]; then
  log "Starting Lomiri shell: ${LOMIRI_BIN} (nested on ${OUTER_DISPLAY})"
  LOMIRI_ENV=(
    "MIR_SERVER_WAYLAND_HOST=${OUTER_DISPLAY}"
    "MIR_SERVER_PLATFORM_DISPLAY_LIBS=mir:wayland"
    "MIR_SERVER_PLATFORM_RENDERING_LIBS=mir:egl-generic"
    "MIR_SERVER_PLATFORM_INPUT_LIB=${MIR_INPUT_LIB}"
    "MIR_SERVER_CONSOLE_PROVIDER=none"
    "QT_QPA_PLATFORM=mirserver"
    "QT_WAYLAND_DISABLE_WINDOWDECORATION=1"
    "GDK_BACKEND=wayland"
  )
  # Mir's nested-Wayland event loop aborts on EINTR (see prebuilt/mir-eintr-shim);
  # the shell spawns short-lived helpers, so a child exiting is enough to kill
  # the desktop without this.
  if [ -f "${MIR_EINTR_SHIM}" ]; then
    LOMIRI_ENV+=("LD_PRELOAD=${MIR_EINTR_SHIM}")
  else
    log "WARNING: ${MIR_EINTR_SHIM} is missing; the shell may abort on a signal"
  fi
  env "${LOMIRI_ENV[@]}" "${LOMIRI_BIN}" --mode=full-shell \
    >"${XDG_RUNTIME_DIR}/lomiri.log" 2>&1 &
  LOMIRI_PID=$!

  # The nested server creates its own Wayland socket (wayland-1 when the outer
  # server holds wayland-0). The shell's own clients - applications launched from
  # the desktop - have to talk to *that* server, so publish it for them.
  LOMIRI_SOCKET="$(wait_for_new_socket "${OUTER_SOCKET}" 60 || true)"
  if [ -n "${LOMIRI_SOCKET}" ]; then
    export WAYLAND_DISPLAY="$(basename "${LOMIRI_SOCKET}")"
    log "Lomiri is up (${LOMIRI_SOCKET})."
  else
    log "WARNING: the Lomiri shell did not create its own Wayland socket yet."
  fi
  if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --all >/dev/null 2>&1 || true
  fi
else
  log "WARNING: no Lomiri shell binary found; Mir is running but no desktop shell is attached."
fi

# ---- 2b. Session state ------------------------------------------------------
#
# The shell draws its own desktop (wallpaper, panel, launcher) with no session at
# all, but a *usable* Lomiri session also needs services this guest only partly
# has. The session/system buses started above let AccountsService and friends be
# activated; what is still missing is the session itself:
#   logind            - no session, so no login, no session list, no Lock/Unlock
#                       signals (the shell logs "Invalid session path");
#   LightDM / PAM     - no way to log a user in;
#   systemd --user    - Debian ships the shell's indicators and app units as
#                       systemd *user* units, which never start without it.
# So the desktop is session-less: this script starts the panel's clock indicator
# and one application by hand (below). Say so, so a wallpaper-only screen is not
# read as a rendering failure.
if [ ! -S /run/dbus/system_bus_socket ]; then
  log "WARNING: no system D-Bus: Lomiri cannot reach AccountsService/logind at all"
fi
log "Note: no logind/LightDM user session and no systemd user session in this guest;"
log "Note: the shell runs session-less, with the clock indicator and one application"
log "Note: started by this script. A wallpaper-only screen is this state."

# ---- 2c. Panel indicators ---------------------------------------------------
#
# Lomiri's panel has no built-in content: every entry (starting with the clock) is
# an indicator *service* that the shell loads over D-Bus. Debian ships them as
# systemd *user* units, and this guest has no user session, so they would never
# start on their own and the panel stays an empty dark strip. Start the clock
# indicator by hand; it owns its bus name and the shell picks it up. Failures are
# not fatal (the desktop still works without a clock).
INDICATOR_PIDS=""
start_indicator() {
  local bin="$1" name="$2"
  [ -x "${bin}" ] || return 0
  "${bin}" >>"${XDG_RUNTIME_DIR}/indicators.log" 2>&1 &
  INDICATOR_PIDS="${INDICATOR_PIDS} $!"
  log "Started the ${name} indicator for the panel"
}

for _indicator in \
  "/usr/libexec/lomiri-indicator-datetime/lomiri-indicator-datetime-service:date/time"; do
  start_indicator "${_indicator%%:*}" "${_indicator##*:}"
  break
done

# ---- 2d. Desktop application -------------------------------------------------
#
# A shell with no windows is still a blank screen. Launch one application on the
# shell's own socket so there is something usable on the desktop, and report it.
# The shell only accepts a client it can identify, which it does by reading the
# client's /proc/<pid>/cmdline (and its environment for APP_ID); under proot the
# guest has /proc bind-mounted for exactly that reason. Set
# TERMDEB_DESKTOP_APP=none to keep the desktop empty.
DESKTOP_APP="${TERMDEB_DESKTOP_APP:-lomiri-terminal-app}"
APP_PID=""
if [ "${DESKTOP_APP}" != "none" ] && [ -n "${WAYLAND_DISPLAY:-}" ] &&
   command -v "${DESKTOP_APP}" >/dev/null 2>&1; then
  log "Starting the desktop application: ${DESKTOP_APP}"
  APP_ID="${DESKTOP_APP}" QT_QPA_PLATFORM="wayland" WAYLAND_DISPLAY="${WAYLAND_DISPLAY}" \
    "${DESKTOP_APP}" >"${XDG_RUNTIME_DIR}/desktop-app.log" 2>&1 &
  APP_PID=$!
else
  if [ "${DESKTOP_APP}" = "none" ]; then
    log "Desktop application disabled (TERMDEB_DESKTOP_APP=none)"
  else
    log "No desktop application available (${DESKTOP_APP} is not installed)"
  fi
fi

# ---- 3. Display/input bridge ------------------------------------------------
BRIDGE_BIN=""
for candidate in termdeb-mir-bridge /usr/local/bin/termdeb-mir-bridge; do
  if command -v "${candidate}" >/dev/null 2>&1; then BRIDGE_BIN="${candidate}"; break; fi
done

if [ -z "${BRIDGE_BIN}" ]; then
  log "ERROR: termdeb-mir-bridge not found; the Android surface cannot be fed."
  exit 1
fi

# The bridge attaches to the OUTER server: that is the output showing the nested
# Lomiri desktop, and the seat the app's input is injected into. Lomiri's Mir
# server receives it as the nested-Wayland input platform.
log "Starting display bridge -> ${FB_PATH} (via ${OUTER_DISPLAY})"
WAYLAND_DISPLAY="${OUTER_DISPLAY}" "${BRIDGE_BIN}" \
  --fb "${FB_PATH}" \
  --input-socket "${INPUT_SOCKET}" \
  --width "${WIDTH}" \
  --height "${HEIGHT}" \
  >>"${XDG_RUNTIME_DIR}/bridge.log" 2>&1 &
BRIDGE_PID=$!

# ---- 4. Keep the session alive and report capture progress -------------------
#
# The Android view only has something to show once frames reach the shared
# framebuffer; until then it is simply black, which is indistinguishable from a
# desktop that failed to start. So watch the framebuffer the bridge writes and
# say so in the session log, with the bridge's own log when nothing arrives.
log "Waiting for the first frame in ${FB_PATH}..."
FRAME_WAIT=0
FRAME_REPORTED=0
while true; do
  if ! kill -0 "${BRIDGE_PID}" 2>/dev/null; then
    log "Display bridge exited."
    break
  fi
  if [ -n "${MIR_PID:-}" ] && ! kill -0 "${MIR_PID}" 2>/dev/null; then
    log "Mir compositor exited."
    break
  fi
  if [ -n "${LOMIRI_PID:-}" ] && ! kill -0 "${LOMIRI_PID}" 2>/dev/null; then
    log "Lomiri shell exited."
    break
  fi
  sleep 2
  FRAME_WAIT=$((FRAME_WAIT + 2))

  _seq=$(read_u32 24 "${FB_PATH}")
  case "${_seq:-x}" in ''|*[!0-9]*) _seq=0 ;; esac
  if [ "${_seq}" -gt 0 ] && [ "${FRAME_REPORTED}" = "0" ]; then
    FRAME_REPORTED=1
    log "Desktop frames are flowing (frame ${_seq}); the Android view is receiving them."
  fi

  # An application the shell refused (or that died) leaves the desktop blank; say
  # so once, with the app's own last lines, instead of leaving it unexplained.
  if [ -n "${APP_PID:-}" ] && [ "${APP_REPORTED:-0}" = "0" ] &&
     ! kill -0 "${APP_PID}" 2>/dev/null; then
    APP_REPORTED=1
    log "WARNING: the desktop application (${DESKTOP_APP}) exited; the desktop has no window."
    log "--- ${XDG_RUNTIME_DIR}/desktop-app.log (tail) ---"
    tail -n 6 "${XDG_RUNTIME_DIR}/desktop-app.log" 2>/dev/null || true
  fi

  # A shell that hit a fatal error can hang instead of exiting, which would leave
  # this loop reporting healthy frames from a frozen compositor.
  if [ "${LOMIRI_FATAL_REPORTED:-0}" = "0" ] && [ -f "${XDG_RUNTIME_DIR}/lomiri.log" ] &&
     grep -qa "Mir fatal error" "${XDG_RUNTIME_DIR}/lomiri.log"; then
    LOMIRI_FATAL_REPORTED=1
    log "WARNING: the Lomiri shell reported a fatal error; the desktop is frozen."
    log "--- ${XDG_RUNTIME_DIR}/lomiri.log (tail) ---"
    tail -n 8 "${XDG_RUNTIME_DIR}/lomiri.log" 2>/dev/null || true
  fi

  if [ "${FRAME_REPORTED}" = "0" ] && [ "${FRAME_WAIT}" = "30" ]; then
    log "WARNING: no desktop frame reached ${FB_PATH} after ${FRAME_WAIT}s; the Android view stays black."
    log "--- ${XDG_RUNTIME_DIR}/bridge.log ---"
    tail -n 20 "${XDG_RUNTIME_DIR}/bridge.log" 2>/dev/null || true
  fi

  # Keep reporting until content appears, then stop spamming the log.
  if [ "${FRAME_REPORTED}" = "1" ] && [ "${FRAME_WAIT}" = "32" ]; then
    log "Desktop frames are flowing; monitoring the session."
  fi
done

exit 0
