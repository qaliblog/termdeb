  "box64": {
    "description": "Box64 - Linux userspace x86_64 emulator for ARM64, prebuilt for glibc (runs inside the Debian trixie proot rootfs). Patched build: MAP_FIXED for fixed-address (ET_EXEC) ELF pre-reserve so huge non-PIE binaries (Bun-compiled apps like opencode) load at their required address on Android kernels that ignore low mmap hints.",
    "version": "0.4.5-local-patched (built from ptitSeb/box64 main, 2026-08-22)",
    "source": "local build (termdeb-assets/prebuilt/box64/build-box64.sh + box64-mapfixed.patch)",
    "source_repo": "https://github.com/ptitSeb/box64",
    "build_method": "local_build",
    "patch": "box64-mapfixed.patch",
    "build_script": "build-box64.sh",
    "target_abi": "arm64",
    "notes": "Built in-guest (Ubuntu aarch64) with -DBAD_SIGNAL=ON -DARM_DYNAREC=ON -DBOX32=1 -DCMAKE_BUILD_TYPE=RelWithDebInfo, then llvm-stripped. The binary is committed at termdeb-assets/prebuilt/box64/box64 and the asset pipeline copies it into the APK (it only falls back to the stock deb download when absent), so CI and public releases ship the patched build. See termdeb-assets/prebuilt/box64/ for source, patch, and rebuild instructions.",
    "required_for_offline": true,
    "license": "MIT",
    "license_url": "https://github.com/ptitSeb/box64/blob/main/LICENSE"
  },
